# ============================================
# SkillSwap Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB Atlas ---
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillswap?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- File Uploads ---
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=uploads

# --- AI Provider (e.g., OpenAI) ---
AI_PROVIDER=openai
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-3.5-turbo

# --- Translation Provider ---
TRANSLATION_PROVIDER=libre
LIBRE_TRANSLATE_URL=https://libretranslate.de

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- Assessment Defaults ---
DEFAULT_PASS_PERCENTAGE=70
DEFAULT_MAX_VIOLATIONS=3
DEFAULT_MAX_ATTEMPTS=3
DEFAULT_COOLDOWN_HOURS=24

# --- Admin Seed ---
ADMIN_EMAIL=admin@skillswap.com
ADMIN_PASSWORD=Admin@123456
